# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
PROJECT_NAME=Sentinel AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma separated list of allowed browser origins (direct API access)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-8d6b0a5f1c2e3d4a5b6c7d8e9f0a1b2c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Browser cookie flags. Secure must be true when served over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
# Used by the API inside Docker compose overrides to host + port
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Seed & bootstrap
# ---------------------------------------------------------------------------
# Runs idempotent seed (admin user + demo cameras/alerts/incidents) on startup
SEED_ON_STARTUP=true
ADMIN_EMAIL=admin@sentinel.gp
ADMIN_PASSWORD=Admin@2026

# ---------------------------------------------------------------------------
# Camera test / stream
# ---------------------------------------------------------------------------
CAMERA_TEST_TIMEOUT_SECONDS=4
# Public base used for API URL generation (optional)
NEXT_PUBLIC_API_BASE=
# Internal backend URL used by the Next.js rewrite proxy (docker: http://api:8000)
API_BACKEND_URL=http://localhost:8000