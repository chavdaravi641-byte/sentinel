{
  "name": "sentinel-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Sentinel AI - Gujarat Police CCTV Intelligence Platform (Monorepo)",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@sentinel/web",
    "build:web": "npm run build --workspace=@sentinel/web",
    "lint:web": "npm run lint --workspace=@sentinel/web",
    "typecheck:web": "npm run typecheck --workspace=@sentinel/web",
    "build:shared": "npm run build --workspace=@sentinel/shared",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:load": "node performance/load-health.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "autocannon": "^8.0.0"
  }
}
